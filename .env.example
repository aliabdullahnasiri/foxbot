# Copy this file to .env and fill in your Telegram settings locally.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL=
TELEGRAM_SESSION=foxbot.session

# Set this to a running broker's URL when using Celery worker mode.
CELERY_BROKER_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60

# MetaTrader 5 terminal account.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD
MT5_MAGIC=20261121

# Keep zero for UTC ticks. For a verified broker feed reporting UTC+2, use 120.
MT5_QUOTE_UTC_OFFSET_MINUTES=0


# Entry deviation and spread are in XAUUSD price units.
MAX_ENTRY_DEVIATION=2.0
MAX_SPREAD=0.5
MAX_SIGNAL_AGE_SECONDS=120
MAX_QUOTE_AGE_SECONDS=10
ENABLE_TRADING=false

LOG_LEVEL=INFO
